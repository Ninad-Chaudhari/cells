#!/usr/bin/env bash
# Builds one cell's sandbox (what it can see) and hands it to the agent supervisor, which runs the agent's
# runtime inside it. The sandbox: the host read-only, the cell's own home and screen, nothing of yours.
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/cells-env"

name="$1"
cell="$SCREENS/$name"
state="$cell/state"
n="$(cat "$cell/display")"
inner="$HOME/.cell"
parent="$(dirname "$HOME")"
runtime="$(cat "$state/runtime" 2>/dev/null || echo claude)"
case "$runtime" in
    claude) runtime_bin="$CELLS_CLAUDE" ;;
    codex) runtime_bin="$CELLS_CODEX" ;;
    *) echo "unknown runtime: $runtime" >&2; exit 2 ;;
esac

args=(
    --ro-bind / /
    --dev /dev --proc /proc
    --tmpfs /tmp
    --ro-bind "/tmp/.X11-unix/X$n" "/tmp/.X11-unix/X$n"
)

# Hide every place that holds your files or other cells' files: the folder of home directories, the
# cells state (other agents' chats, credentials) and the local cell homes (other agents' browser profiles).
hidden=()
for root in "$parent" "$CELLS_HOME" "$CELLS_LOCAL"; do
    [ -n "$root" ] && [ "$root" != "/" ] && [ -d "$root" ] || continue
    case "$root/" in "$parent"/*) [ "$root" = "$parent" ] || continue ;; esac
    hidden+=("$root")
    args+=(--tmpfs "$root")
done
args+=(--bind "$cell/home" "$HOME")

# Tools the agent needs that live inside a hidden folder come back read-only.
keep() {
    local p h
    for p in "$@"; do
        [ -n "$p" ] && [ -e "$p" ] || continue
        for h in "${hidden[@]}"; do
            case "$p" in "$h"/*) args+=(--ro-bind "$p" "$p"); break ;; esac
        done
    done
}
runtime_real="$(readlink -f "$runtime_bin")"
keep "$(dirname "$(dirname "$runtime_real")")" "$(dirname "$(dirname "$(readlink -f "$CELLS_NODE")")")" "$CELLS_HOME/opt"
# Playwright's Chromium: share only its own folder, so the rest of ~/.cache/ms-playwright (where Playwright
# MCP keeps lock files) stays the cell's own and writable.
chrome_real="$(readlink -f "$CELLS_CHROME_BIN")"
case "$chrome_real" in
    "$HOME"/.cache/ms-playwright/*) rel="${chrome_real#"$HOME"/.cache/ms-playwright/}"; keep "$HOME/.cache/ms-playwright/${rel%%/*}" ;;
    *) keep "$(dirname "$chrome_real")" ;;
esac

args+=(
    --ro-bind "$state" "$inner/state"
    --bind "$state/agent" "$inner/state/agent"
    --bind "$cell/knowledge" "$inner/knowledge"
    --ro-bind "$CELLS_APP/bin/need-help" "$inner/bin/need-help"
    --ro-bind "$CELLS_APP/bin/cell-chrome" "$inner/bin/cell-chrome"
    --ro-bind "$CELLS_APP/bin/cell-inbox-hook" "$inner/bin/cell-inbox-hook"
    --tmpfs "/run/user/$(id -u)"
    --unshare-pid --die-with-parent --new-session
    --chdir "$HOME"
)

mkdir -p "$cell/home/.cell/config" "$state/agent"
exec python3 "$CELLS_APP/bin/cell-agent-io" "$name" -- bwrap "${args[@]}"
