#!/usr/bin/env bash
# Inside a cell: ask the operator for help and wait for their answer. The request goes in state/agent (the
# one folder a cell can write); the answer comes back as state/help-answer-ID.
set -euo pipefail

state="${CELL_STATE:?}"
mine="$state/agent"
owner="${CELLS_OWNER:-your operator}"
wait_s="${NEED_HELP_WAIT:-110}"

if [ $# -gt 0 ]; then
    id="$(date +%s%N)"
    python3 -c 'import json, sys, time; json.dump({"message": sys.argv[1], "at": int(time.time()), "id": sys.argv[3]}, open(sys.argv[2], "w"))' \
        "$*" "$mine/help.json" "$id"
    echo "$id" > "$mine/help-waiting"
elif [ ! -s "$mine/help-waiting" ]; then
    echo 'usage: need-help "what you need"' >&2
    exit 2
fi
ans="$state/help-answer-$(cat "$mine/help-waiting")"

echo "Asked $owner for help; waiting."
end=$((SECONDS + wait_s))
while [ "$SECONDS" -lt "$end" ]; do
    if [ -e "$ans" ]; then
        echo "$owner is done helping. Note: $(cat "$ans")"
        echo "Check the screen again before you continue; it may have changed."
        rm -f "$mine/help-waiting"
        exit 0
    fi
    sleep 2
done
echo "No answer yet. The request is still open; run need-help with no arguments to keep waiting."
