#!/usr/bin/env python3
"""Supervises one agent session.

Feeds the task (and later messages) to `claude -p --input-format stream-json` on stdin,
copies its event stream to state/stream.jsonl, flips state/status between running and idle,
commits knowledge after every turn, and delivers queued messages from state/inbox when the
agent is idle. Messages that arrive mid-task are delivered by the PostToolUse hook instead.
"""
import base64
import json
import mimetypes
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

state = Path(sys.argv[1])
cmd = sys.argv[sys.argv.index("--") + 1:]
inbox = state / "inbox"
delivered = inbox / "delivered"
files = inbox / "files"
kb_commit = Path(__file__).resolve().parent / "cell-kb-commit"
delivered.mkdir(parents=True, exist_ok=True)
files.mkdir(parents=True, exist_ok=True)

lock = threading.Lock()
idle = threading.Event()
logged = {p.name for p in delivered.iterdir()}


def set_status(value):
    (state / "status").write_text(value + "\n")


def log(line):
    with lock:
        with open(state / "stream.jsonl", "a") as fh:
            fh.write(line if line.endswith("\n") else line + "\n")


def send(content):
    msg = {"type": "user", "message": {"role": "user", "content": content}}
    with lock:
        proc.stdin.write(json.dumps(msg) + "\n")
        proc.stdin.flush()


def read_msg(path):
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return "", []
    return str(data.get("text", "")).strip(), [str(i) for i in data.get("images", []) if isinstance(i, str)]


def note(name, text, images, via):
    logged.add(name)
    log(json.dumps({"type": "cell_message", "from": "operator", "text": text, "images": images,
                    "via": via, "at": int(time.time())}))


def image_block(rel):
    path = (inbox / rel).resolve()
    if inbox.resolve() not in path.parents or not path.is_file():
        return None
    media = mimetypes.guess_type(path.name)[0] or "image/png"
    return {"type": "image", "source": {"type": "base64", "media_type": media,
                                        "data": base64.b64encode(path.read_bytes()).decode()}}


def watch_inbox():
    while proc.poll() is None:
        for p in sorted(delivered.glob("*.json")):
            if p.name not in logged:
                text, images = read_msg(p)
                note(p.name, text, images, "during-task")
        if idle.is_set():
            content = []
            for p in sorted(inbox.glob("*.json")):
                target = delivered / p.name
                try:
                    os.rename(p, target)
                except OSError:
                    continue
                text, images = read_msg(target)
                if not text and not images:
                    continue
                note(target.name, text, images, "new-turn")
                if text:
                    content.append({"type": "text", "text": text})
                for rel in images:
                    block = image_block(rel)
                    if block:
                        content.append(block)
            if content:
                idle.clear()
                set_status("running")
                send(content)
        time.sleep(1)


with open(state / "stderr.log", "a") as err:
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=err, text=True, bufsize=1)
    set_status("running")
    send((state / "task.txt").read_text().strip())
    threading.Thread(target=watch_inbox, daemon=True).start()
    for line in proc.stdout:
        log(line)
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") == "result":
            subprocess.run([str(kb_commit), state.parent.name])
            if not any(inbox.glob("*.json")):
                set_status("idle")
            idle.set()
    sys.exit(proc.wait())
