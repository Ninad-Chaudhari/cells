#!/usr/bin/env python3
"""PostToolUse hook inside a cell: hands queued operator messages to the agent mid-task. The inbox is read-only
in here, so the hook lists what it handed over in state/agent/delivered and the supervisor files those away."""
import json
import os
import sys
from pathlib import Path

sys.stdin.read()
state = Path(os.environ.get("CELL_STATE", ""))
inbox = state / "inbox"
receipts = state / "agent" / "delivered"
owner = os.environ.get("CELLS_OWNER", "your operator")

try:
    handed = set(receipts.read_text().split())
except OSError:
    handed = set()

names, parts = [], []
for p in sorted(inbox.glob("*.json")):
    if p.name in handed:
        continue
    try:
        data = json.loads(p.read_text())
    except (OSError, ValueError):
        continue
    names.append(p.name)
    text = str(data.get("text", "")).strip()
    images = [str(inbox / i) for i in data.get("images", []) if isinstance(i, str)]
    if images:
        text += ("\n" if text else "") + "Attached image(s), open them with the Read tool: " + ", ".join(images)
    if text:
        parts.append(text)

if names:
    try:
        with open(receipts, "a") as fh:
            fh.write("".join(f"{n}\n" for n in names))
    except OSError:
        sys.exit(0)  # without a receipt they would be handed over twice: leave them for the next turn

if parts:
    body = "\n\n".join(parts)
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": f"New message from {owner}, sent while you were working:\n{body}\n"
                             "Acknowledge it briefly and adjust what you are doing.",
    }}))
